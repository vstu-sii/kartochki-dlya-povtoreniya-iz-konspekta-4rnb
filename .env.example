# Для качественных карточек и смысловой проверки: gemini + бесплатный ключ Google AI Studio.
# Без ключа система автоматически использует воспроизводимый локальный baseline.
MODEL_PROVIDER=gemini
GEMINI_API_KEY=
LLM_PRIMARY_MODEL=gemini-3.8-flash
LLM_CHEAP_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_ATTEMPTS=2
AI_TIMEOUT_SECONDS=65
AI_MAX_ATTEMPTS=2
TELEGRAM_BOT_TOKEN=
TRACE_CONTENT=false
OCR_LANGUAGES=rus+eng
PDF_MAX_PAGES=40
PDF_MAX_TOTAL_CHARS=180000
MAX_REQUESTS_PER_USER_DAY=50
MAX_TOKENS_PER_USER_DAY=120000
BUDGET_DEGRADE_RATIO=0.80

POSTGRES_DB=cards
POSTGRES_USER=cards
POSTGRES_PASSWORD=cards
