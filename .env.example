# Скопируй этот файл в .env и заполни реальными значениями. Сам .env в git не коммитим.

# Токен телеграм бота, получить у @BotFather
TELEGRAM_BOT_TOKEN=

# Ключ доступа к LLM API (провайдера выберет AI Engineer в лабе, см docs/model-candidates.md)
LLM_API_KEY=
LLM_API_BASE_URL=
LLM_MODEL_NAME=

# Лимит токенов на один запрос, чтобы не улететь по бюджету
LLM_MAX_TOKENS_PER_REQUEST=2000

# Настройки хранилища (пока заглушка, реальная схема появится в лабе 2)
DATABASE_URL=

# Режим запуска: dev или prod
APP_ENV=dev
