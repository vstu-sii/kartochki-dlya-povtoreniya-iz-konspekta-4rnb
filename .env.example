# Токен телеграм бота, получить у @BotFather
TELEGRAM_BOT_TOKEN=

# Ключ доступа к LLM API 
LLM_API_KEY=
LLM_API_BASE_URL=
LLM_PRIMARY_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite

# Лимит токенов на один запрос
LLM_MAX_TOKENS_PER_REQUEST=2000

# Настройки хранилища 
POSTGRES_DB=cards
POSTGRES_USER=cards
POSTGRES_PASSWORD=cards
DATABASE_URL=postgresql://cards:cards@localhost:5432/cards

# Режим запуска: dev или prod
APP_ENV=dev
