@startuml
left to right direction
skinparam packageStyle rectangle

actor "Студент" as Student

rectangle "Карточки для устной защиты" {
  usecase "UC-01\nСоздать карточки\nиз PDF" as UC01
  usecase "UC-02\nПройти раунд\nвопрос–ответ" as UC02
  usecase "UC-03\nОценить полезность\nкарточки" as UC03
  usecase "UC-04\nЗавершить /\nвозобновить сессию" as UC04
  usecase "UC-05\nБезопасно отклонить\nнеподдерживаемый PDF" as UC05
  usecase "Проверить файл" as Validate
  usecase "Проверить grounding\nи структуру" as Ground
}

Student --> UC01
Student --> UC02
Student --> UC03
Student --> UC04
Student --> UC05

UC01 .> Validate : <<include>>
UC01 .> Ground : <<include>>
UC05 .> Validate : <<include>>
UC03 .> UC02 : <<extend>>
UC04 .> UC02 : <<extend>>
@enduml
