  "components": {
    "schemas": {
      "Body_generate_card_set_from_pdf_v1_ai_card_sets_from_pdf_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          },
          "requested_card_count": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 5.0,
            "title": "Requested Card Count",
            "default": 5
          },
          "language": {
            "type": "string",
            "pattern": "^(ru|en)$",
            "title": "Language",
            "default": "ru"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_generate_card_set_from_pdf_v1_ai_card_sets_from_pdf_post"
      },
      "CardPayload": {
        "properties": {
          "card_id": {
            "type": "string",
            "title": "Card Id"
          },
          "question": {
            "type": "string",
            "title": "Question"
          },
          "reference_answer": {
            "type": "string",
            "title": "Reference Answer"
          },
          "source_page": {
            "type": "integer",
            "title": "Source Page"
          },
          "source_quote": {
            "type": "string",
            "title": "Source Quote"
          },
          "difficulty": {
            "type": "string",
            "title": "Difficulty",
            "default": "basic"
          }
        },
        "type": "object",
        "required": [
          "card_id",
          "question",
          "reference_answer",
          "source_page",
          "source_quote"
        ],
        "title": "CardPayload"
      },
      "CompleteRequest": {
        "properties": {
          "answers": {
            "items": {
              "type": "object"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Answers"
          }
        },
        "type": "object",
        "title": "CompleteRequest"
      },
      "GenerateRequest": {
        "properties": {
          "document_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Document Id"
          },
          "language": {
            "type": "string",
            "pattern": "^(ru|en)$",
            "title": "Language",
            "default": "ru"
          },
          "pages": {
            "items": {
              "$ref": "#/components/schemas/Page"
            },
            "type": "array",
            "maxItems": 40,
            "minItems": 1,
            "title": "Pages"
          },
          "requested_card_count": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 5.0,
            "title": "Requested Card Count",
            "default": 5
          }
        },
        "type": "object",
        "required": [
          "document_id",
          "pages"
        ],
        "title": "GenerateRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Page": {
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page"
          },
          "text": {
            "type": "string",
            "maxLength": 200000,
            "minLength": 10,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "page",
          "text"
        ],
        "title": "Page"
      },
      "ProgressRequest": {
        "properties": {
          "current_position": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Current Position"
          }
        },
        "type": "object",
        "required": [
          "current_position"
        ],
        "title": "ProgressRequest"
      },
      "RatingRequest": {
        "properties": {
          "value": {
            "type": "string",
            "pattern": "^(useful|not_useful|off_topic)$",
            "title": "Value"
          }
        },
        "type": "object",
        "required": [
          "value"
        ],
        "title": "RatingRequest"
      },
      "ReviewRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 8,
            "title": "Session Id"
          },
          "card": {
            "$ref": "#/components/schemas/CardPayload"
          },
          "student_answer": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Student Answer"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "card",
          "student_answer"
        ],
        "title": "ReviewRequest"
      },
      "SessionRequest": {
        "properties": {
          "card_set_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 8,
            "title": "Card Set Id"
          },
          "user_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "User Id"
          }
        },
        "type": "object",
        "required": [
          "card_set_id",
          "user_id"
        ],
        "title": "SessionRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}